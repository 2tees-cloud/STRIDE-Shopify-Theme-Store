{% doc %}
  Renders a newsletter signup form using Shopify's native customer form.

  @example
  {% content_for 'block', type: 'newsletter-signup', id: 'newsletter-signup' %}
{% enddoc %}

{% comment %}
  Known limitation: if the homepage newsletter-band section is also
  active on the same page, both it and this block use bare
  {% form 'customer' %}. Shopify's form object populates
  form.posted_successfully?/form.errors/form.email from which form TYPE
  was submitted in the current request, not from which specific
  {% form %}...{% endform %} instance rendered on the page — adding an
  id: parameter to the form tag only customizes the rendered <form>
  element's HTML id attribute, it does not scope this state per
  instance. There is no documented native mechanism to distinguish
  them. Practical effect: submitting either form will show
  success/error state in BOTH places simultaneously. This is expected
  native Shopify Liquid behavior when the same form type is used twice
  on one page, not a bug in this theme's code.
{% endcomment %}

<div class="newsletter-signup" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="newsletter-signup__heading">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.subtext != blank %}
    <p class="newsletter-signup__subtext">{{ block.settings.subtext }}</p>
  {% endif %}

  {% form 'customer', class: 'newsletter-signup__form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">

    {% if form.posted_successfully? %}
      <p class="newsletter-signup__success">{{ 'newsletter.success' | t }}</p>
    {% else %}
      {% if form.errors %}
        <div class="newsletter-signup__error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="newsletter-signup__field">
        <label for="NewsletterEmail-{{ block.id }}">{{ 'newsletter.email' | t }}</label>
        <input
          type="email"
          name="contact[email]"
          id="NewsletterEmail-{{ block.id }}"
          autocomplete="email"
          value="{% if form.email %}{{ form.email | escape }}{% endif %}"
          required
        >
        <button type="submit">{{ 'newsletter.submit' | t }}</button>
      </div>
    {% endif %}
  {% endform %}
</div>

{% stylesheet %}
  .newsletter-signup__heading {
    font-family: var(--font-header--family);
    font-size: 1rem;
    margin: 0 0 var(--space-1);
  }
  .newsletter-signup__subtext {
    color: var(--color-foreground-muted);
    margin: 0 0 var(--space-2);
  }
  .newsletter-signup__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-start;
  }
  .newsletter-signup__field input {
    width: 100%;
    border: 1px solid var(--color-foreground-muted);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    padding: var(--space-2);
  }
  .newsletter-signup__field button {
    border: 1px solid var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    min-height: 24px;
  }
  .newsletter-signup__success {
    color: var(--color-foreground);
    font-weight: 700;
  }
  .newsletter-signup__error {
    color: var(--color-urgency);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "t:labels.subtext"
    }
  ],
  "presets": [{ "name": "t:general.newsletter" }]
}
{% endschema %}
