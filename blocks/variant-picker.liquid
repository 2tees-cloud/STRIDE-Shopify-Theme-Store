{% doc %}
  Renders one control per product option (Color, Size, etc.) — swatch
  buttons when the merchant has configured swatches for that option,
  plain text pill buttons otherwise. Selecting an option re-runs
  variant matching in assets/product-variant-picker.js, which updates
  price, sold-out state, the active gallery image, and the URL —
  entirely client-side, no network round-trip.

  Swatch API shape confirmed against Shopify Liquid docs
  (https://shopify.dev/docs/api/liquid/objects/product_option_value):
  product.options_with_values[].values[] returns product_option_value
  objects with a `.name` (display string, NOT `.value`) and a nilable
  `.swatch` (https://shopify.dev/docs/api/liquid/objects/swatch), whose
  `.color` outputs a hex string directly and whose `.image` is a real
  image object requiring `image_url`.

  @example
  {% content_for 'block', type: 'variant-picker', id: 'variant-picker' %}
{% enddoc %}

{% if product.has_only_default_variant == false %}
  <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
    {% for option in product.options_with_values %}
      <fieldset class="variant-picker__option">
        <legend class="variant-picker__option-label">{{ option.name }}</legend>
        {% comment %}
          No role="radiogroup"/aria-label here — the <fieldset>/<legend>
          above already provides correct grouping+naming semantics.
          These buttons use aria-pressed (toggle-button semantics), not
          role="radio"/aria-checked (radio semantics), so wrapping them
          in role="radiogroup" would be an ARIA pattern mismatch: a
          labeled group of toggle buttons is the correct, simpler
          pattern here, not a radio group.
        {% endcomment %}
        <div class="variant-picker__values">
          {% for value in option.values %}
            <button
              type="button"
              class="variant-picker__value{% if value.swatch %} variant-picker__value--swatch{% endif %}{% if value.selected %} is-active{% endif %}"
              data-variant-option-value
              data-option-position="{{ option.position }}"
              data-option-value="{{ value.name | escape }}"
              aria-pressed="{{ value.selected }}"
              {% if value.swatch.color %}
                style="--swatch-color: {{ value.swatch.color }};"
              {% elsif value.swatch.image %}
                style="--swatch-image: url('{{ value.swatch.image | image_url: width: 64 }}');"
              {% endif %}
            >
              {% if value.swatch %}
                {% comment %}
                  The visually-hidden name is only needed here: a swatch
                  value's visible content is just a color circle (no
                  text), so screen readers need this to announce
                  anything at all. A plain text pill already renders
                  {{ value.name }} as its visible content — adding this
                  span there too would announce the name twice
                  ("Black Black").
                {% endcomment %}
                <span class="visually-hidden">{{ value.name }}</span>
              {% else %}
                {{ value.name }}
              {% endif %}
            </button>
          {% endfor %}
        </div>
      </fieldset>
    {% endfor %}

    {% if block.settings.show_size_chart %}
      {% render 'size-chart-modal' %}
    {% endif %}

    {% comment %}
      This script tag MUST be a descendant of [data-variant-picker],
      not a sibling — assets/product-variant-picker.js looks it up
      with picker.querySelector('[data-product-variants-json]'), where
      `picker` is this very div. A sibling placement means that query
      silently finds nothing, variants.length is 0, and
      initVariantPicker() returns before attaching any click listeners
      (verified live: this exact bug was caught this way).
    {% endcomment %}
    <script type="application/json" data-product-variants-json>
      [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | json }},
            "price_formatted": {{ variant.price | money | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "compare_at_price_formatted": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},
            "unit_price": {% if variant.unit_price_measurement %}{{ variant.unit_price | money | json }}{% else %}null{% endif %},
            "unit_price_measurement_reference_value": {% if variant.unit_price_measurement %}{{ variant.unit_price_measurement.reference_value | json }}{% else %}null{% endif %},
            "unit_price_measurement_reference_unit": {% if variant.unit_price_measurement %}{{ variant.unit_price_measurement.reference_unit | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  </div>
{% endif %}

{% stylesheet %}
  .variant-picker {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .variant-picker__option {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .variant-picker__option-label {
    /*
      Not a flex `gap`-created space: a <fieldset>'s rendered <legend>
      is not a flex item (browsers give it special out-of-flow-like
      rendering within the fieldset), so it doesn't participate in
      .variant-picker__option's flex gap above — the only actual flex
      child is .variant-picker__values, meaning that gap would do
      nothing between the legend and the pills row. This explicit
      margin creates that spacing directly instead.
    */
    margin-block-end: var(--space-2);
    padding: 0;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .variant-picker__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .variant-picker__value {
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: var(--space-2) var(--space-3);
    /*
      --color-border (#DDD8CE) on --color-background (#F7F5F1) measures
      ~1.3:1, well under the 3:1 non-text-UI contrast threshold. Scoped
      here to --color-foreground-muted (#6B665D on #F7F5F1 ≈ 5.23:1)
      rather than changing the global --color-border token, following
      this project's existing precedent of swapping a failing
      --color-border usage for --color-foreground-muted on the specific
      component rather than touching the shared token.
    */
    border: 1px solid var(--color-foreground-muted);
    background-color: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    font-size: 0.875rem;
  }
  .variant-picker__value.is-active {
    /*
      Deliberately border/box-shadow, not outline: outline here would
      have specificity 0,2,0, which beats critical.css's global
      :focus-visible outline (0,1,0) regardless of source order —
      tabbing onto the currently-selected pill would then show no
      visible focus change at all (WCAG 2.4.7). box-shadow doesn't
      collide with the outline property, so :focus-visible's outline
      can still render on top of/alongside this selected-state
      indicator.
    */
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 2px var(--color-foreground) inset;
  }
  .variant-picker__value--swatch {
    min-width: 2.5rem;
    min-height: 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border-radius: 50%;
    background-color: var(--swatch-color, var(--color-background-alt));
    background-image: var(--swatch-image, none);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    text-indent: -9999px;
  }
  .variant-picker__value[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.variant_picker",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_size_chart",
      "label": "t:labels.show_size_chart",
      "default": false
    }
  ]
}
{% endschema %}
