{% doc %}
  Renders one control per product option (Color, Size, etc.) — swatch
  buttons when the merchant has configured swatches for that option,
  plain text pill buttons otherwise. Selecting an option re-runs
  variant matching in assets/product-variant-picker.js, which updates
  price, sold-out state, the active gallery image, and the URL —
  entirely client-side, no network round-trip.

  Swatch API shape confirmed against Shopify Liquid docs
  (https://shopify.dev/docs/api/liquid/objects/product_option_value):
  product.options_with_values[].values[] returns product_option_value
  objects with a `.name` (display string, NOT `.value`) and a nilable
  `.swatch` (https://shopify.dev/docs/api/liquid/objects/swatch), whose
  `.color` outputs a hex string directly and whose `.image` is a real
  image object requiring `image_url`.

  @example
  {% content_for 'block', type: 'variant-picker', id: 'variant-picker' %}
{% enddoc %}

{% if product.has_only_default_variant == false %}
  <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
    {% for option in product.options_with_values %}
      <fieldset class="variant-picker__option">
        <legend class="variant-picker__option-label">{{ option.name }}</legend>
        <div class="variant-picker__values" role="radiogroup" aria-label="{{ option.name }}">
          {% for value in option.values %}
            <button
              type="button"
              class="variant-picker__value{% if value.swatch %} variant-picker__value--swatch{% endif %}{% if value.selected %} is-active{% endif %}"
              data-variant-option-value
              data-option-position="{{ option.position }}"
              data-option-value="{{ value.name | escape }}"
              aria-pressed="{{ value.selected }}"
              {% if value.swatch.color %}
                style="--swatch-color: {{ value.swatch.color }};"
              {% elsif value.swatch.image %}
                style="--swatch-image: url('{{ value.swatch.image | image_url: width: 64 }}');"
              {% endif %}
            >
              {% unless value.swatch %}{{ value.name }}{% endunless %}
              <span class="visually-hidden">{{ value.name }}</span>
            </button>
          {% endfor %}
        </div>
      </fieldset>
    {% endfor %}

    {% comment %}
      snippets/size-chart-modal.liquid is created in Task 3. Re-enable
      this render once that snippet exists.
      {% render 'size-chart-modal' %}
    {% endcomment %}

    {% comment %}
      This script tag MUST be a descendant of [data-variant-picker],
      not a sibling — assets/product-variant-picker.js looks it up
      with picker.querySelector('[data-product-variants-json]'), where
      `picker` is this very div. A sibling placement means that query
      silently finds nothing, variants.length is 0, and
      initVariantPicker() returns before attaching any click listeners
      (verified live: this exact bug was caught this way).
    {% endcomment %}
    <script type="application/json" data-product-variants-json>
      [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | json }},
            "price_formatted": {{ variant.price | money | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "compare_at_price_formatted": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  </div>
{% endif %}

{% stylesheet %}
  .variant-picker {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .variant-picker__option {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .variant-picker__option-label {
    padding: 0;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .variant-picker__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .variant-picker__value {
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    font-size: 0.875rem;
  }
  .variant-picker__value.is-active {
    border-color: var(--color-foreground);
    outline: 2px solid var(--color-foreground);
    outline-offset: -1px;
  }
  .variant-picker__value--swatch {
    min-width: 2.5rem;
    min-height: 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border-radius: 50%;
    background-color: var(--swatch-color, var(--color-background-alt));
    background-image: var(--swatch-image, none);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    text-indent: -9999px;
  }
  .variant-picker__value[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.variant_picker",
  "settings": []
}
{% endschema %}
