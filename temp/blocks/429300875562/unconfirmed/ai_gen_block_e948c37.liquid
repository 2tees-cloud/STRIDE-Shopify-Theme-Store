{% doc %}
  @prompt
    menu
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-menu-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-menu-{{ ai_gen_id }}__title {
    margin: 0 0 1rem;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-menu-{{ ai_gen_id }}__list {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-menu-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ai-menu-{{ ai_gen_id }}__link:hover,
  .ai-menu-{{ ai_gen_id }}__link:focus-visible {
    color: {{ block.settings.hover_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-menu-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.hover_color }};
    outline-offset: 4px;
    border-radius: 2px;
  }

  .ai-menu-{{ ai_gen_id }}__empty {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: {{ block.settings.text_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-menu-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<nav class="ai-menu-{{ ai_gen_id }}" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-menu-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>
  {% endif %}

  {% if block.settings.menu != blank %}
    <ul class="ai-menu-{{ ai_gen_id }}__list">
      {% for link in block.settings.menu.links %}
        <li>
          <a class="ai-menu-{{ ai_gen_id }}__link" href="{{ link.url }}">
            {{ link.title | escape }}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="ai-menu-{{ ai_gen_id }}__empty">Select a menu to display navigation links.</p>
  {% endif %}
</nav>

{% schema %}
{
  "name": "Menu",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Link font",
      "default": "work_sans_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Link size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#141311"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Links",
      "default": "#141311"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover",
      "default": "#A84A29"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Empty state",
      "default": "#6B665D"
    }
  ],
  "presets": [
    {
      "name": "Menu"
    }
  ],
  "tag": null,
  "class": "menu-block"
}
{% endschema %}