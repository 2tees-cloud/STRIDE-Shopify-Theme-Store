<header class="header">
  <button
    type="button"
    class="header__nav-toggle"
    data-mobile-nav-trigger
    aria-expanded="false"
    aria-controls="MobileNavPanel"
    aria-label="{{ 'labels.menu' | t }}"
  >
    {{ 'icon-menu.svg' | inline_asset_content }}
  </button>

  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__panel" id="MobileNavPanel">
    <div class="header__panel-header">
      <button type="button" class="header__panel-close" data-mobile-nav-close aria-label="{{ 'labels.close_menu' | t }}">
        {{ 'icon-x.svg' | inline_asset_content }}
      </button>
    </div>

    <nav class="header__menu" aria-label="{{ 'labels.menu' | t }}">
      {% for link in section.settings.menu.links %}
        {% if link.links.size > 0 %}
          <details class="header__menu-item">
            <summary>{{ link.title }}</summary>
            <ul class="header__submenu">
              {% for child_link in link.links %}
                <li>
                  <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </details>
        {% else %}
          <a class="header__menu-item" href="{{ link.url }}">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="header__localization">
      {% if localization.available_countries.size > 1 %}
        {% form 'localization', id: 'HeaderCountryForm', class: 'header__localization-form' %}
          <select name="country_code" aria-label="{{ 'labels.country' | t }}" data-localization-form-submit>
            {% for country in localization.available_countries %}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                {{ country.name }} ({{ country.currency.iso_code }})
              </option>
            {% endfor %}
          </select>
          <noscript>
            <button type="submit">{{ 'labels.update' | t }}</button>
          </noscript>
        {% endform %}
      {% endif %}

      {% if localization.available_languages.size > 1 %}
        {% form 'localization', id: 'HeaderLanguageForm', class: 'header__localization-form' %}
          <select name="language_code" aria-label="{{ 'labels.language' | t }}" data-localization-form-submit>
            {% for language in localization.available_languages %}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{ language.endonym_name | capitalize }}
              </option>
            {% endfor %}
          </select>
          <noscript>
            <button type="submit">{{ 'labels.update' | t }}</button>
          </noscript>
        {% endform %}
      {% endif %}
    </div>
  </div>

  <div class="header__icons">
    <div class="header__search">
      <button
        type="button"
        class="header__search-trigger"
        data-search-trigger
        aria-expanded="false"
        aria-controls="HeaderSearchPanel"
        aria-label="{{ 'search.title' | t }}"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>

      <div class="header__search-panel" id="HeaderSearchPanel" data-search-panel hidden>
        {% render 'predictive-search', id_prefix: 'HeaderSearch' %}
      </div>
    </div>

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" data-cart-drawer-trigger aria-label="{{ 'cart.title' | t }}">
      <sup data-cart-count class="{% if cart.item_count == 0 %}is-hidden{% endif %}">{{ cart.item_count }}</sup>

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

<div class="header__panel-overlay" data-mobile-nav-overlay hidden></div>

{% stylesheet %}
  .shopify-section-group-header-group:has(header.header) {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-background);
  }
  header.header {
    padding-block: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background-color: var(--color-background);
    transition: padding-block 0.2s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    header.header {
      transition: none;
    }
  }
  header.header.header--condensed {
    padding-block: var(--space-2);
  }
  header .header__title {
    font-family: var(--font-header--family);
    font-style: var(--font-header--style);
    font-weight: var(--font-header--weight);
    flex: 1;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header a sup.is-hidden {
    display: none;
  }
  header svg {
    width: 2rem;
    flex-shrink: 0;
  }
  header .header__icons {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  header .header__search {
    position: relative;
  }
  header .header__search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
  }
  header .header__search-panel {
    position: absolute;
    top: 100%;
    right: 0;
    width: min(24rem, 90vw);
    z-index: 15;
  }
  header .header__search-panel[hidden] {
    display: none;
  }
  @media (max-width: 749px) {
    /* Below the mobile-nav breakpoint, an anchored dropdown pinned to the
       search icon's right edge runs off the left side of narrow
       viewports (the icon sits well right-of-center, before the
       account/cart icons). Making .header__search position: static hands
       the panel's absolute positioning up to its next positioned
       ancestor -- .shopify-section-group-header-group:has(header.header),
       the header's own sticky wrapper -- so top: 100% lands the panel
       right under the header row itself, full width, correctly whether
       the header is still in normal flow (announcement bar showing above
       it) or already pinned to the top from scrolling; a fixed pixel
       offset can't account for both of those the same way. */
    header .header__search {
      position: static;
    }
    header .header__search-panel {
      position: absolute;
      top: 100%;
      left: var(--space-4);
      right: var(--space-4);
      width: auto;
    }
  }

  header .header__nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    flex-shrink: 0;
  }
  header .header__nav-toggle svg {
    width: 1.5rem;
  }
  header .header__panel-header {
    display: flex;
    justify-content: flex-end;
  }
  header .header__panel-close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
  }

  header .header__panel {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(20rem, 85vw);
    background-color: var(--color-surface);
    z-index: 21;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
  }
  header .header__panel.is-open {
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    header .header__panel {
      transition: none;
    }
  }
  .header__panel-overlay {
    position: fixed;
    inset: 0;
    background-color: rgb(0 0 0 / 40%);
    z-index: 20;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }
  .header__panel-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .header__panel-overlay {
      transition: none;
    }
  }

  header .header__menu {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  header .header__localization {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (min-width: 750px) {
    header .header__nav-toggle {
      display: none;
    }
    header .header__panel {
      position: static;
      width: auto;
      transform: none;
      transition: none;
      padding: 0;
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
      overflow: visible;
    }
    header .header__panel-header {
      display: none;
    }
    header .header__menu {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
    header .header__localization {
      flex-direction: row;
      gap: 1rem;
    }
    .header__panel-overlay {
      display: none;
    }
  }

  header .header__menu-item {
    color: var(--color-foreground);
    cursor: pointer;
    display: flex;
    align-items: center;
    min-height: 24px;
  }
  header details.header__menu-item {
    position: relative;
    flex-direction: column;
    align-items: flex-start;
  }
  header details.header__menu-item > summary {
    list-style: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    min-height: 24px;
  }
  header details.header__menu-item > summary::-webkit-details-marker {
    display: none;
  }
  header details[open].header__menu-item > summary {
    color: var(--color-accent);
  }
  header .header__submenu {
    position: static;
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0 0 var(--space-4);
    background-color: transparent;
    border: none;
    min-width: 0;
  }
  @media (min-width: 750px) {
    header details.header__menu-item {
      flex-direction: row;
      align-items: center;
    }
    header .header__submenu {
      position: absolute;
      top: 100%;
      left: 0;
      padding: var(--space-2);
      background-color: var(--color-surface);
      /*
        --color-border on --color-surface measures ~1.42:1, well under
        the 3:1 non-text-UI contrast threshold. This is an interactive
        menu's own boundary (it delineates a clickable dropdown), so per
        this project's convention it's scoped to --color-foreground-muted
        (~5.70:1 on --color-surface) rather than the low-contrast
        decorative token, following the existing precedent in
        sections/product.liquid and snippets/collection-filters.liquid.
      */
      border: 1px solid var(--color-foreground-muted);
      min-width: 10rem;
      z-index: 1;
    }
  }
  header .header__submenu a {
    display: block;
    padding-block: var(--space-1);
    color: var(--color-foreground);
    text-decoration: none;
  }
  header .header__localization-form select {
    /* Same --color-border-on-interactive-boundary fix as .header__submenu above. */
    border: 1px solid var(--color-foreground-muted);
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding: var(--space-1) var(--space-2);
    min-height: 24px;
    font: inherit;
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% javascript %}
  function initStickyHeader(root) {
    var sentinel = document.querySelector('[data-scroll-sentinel]');
    var header = root.querySelector('.header');
    if (!sentinel || !header) return;

    if (window.__strideStickyObserver) {
      window.__strideStickyObserver.disconnect();
    }

    var observer = new IntersectionObserver(function (entries) {
      header.classList.toggle('header--condensed', !entries[0].isIntersecting);
    });
    observer.observe(sentinel);
    window.__strideStickyObserver = observer;
  }

  function initStickyHeaderHeightVar() {
    // Shopify's sections Liquid tag (used to render section groups) does
    // NOT emit one shared wrapper around the whole group — it wraps EACH
    // section in the group in its own .shopify-section-group-header-group
    // element. header-group.json's order is ["announcement-bar",
    // "header"], so a bare querySelector('.shopify-section-group-header-
    // group') returns the announcement bar's wrapper (first in document
    // order), not the header's. The :has() qualifier below is required
    // to disambiguate and target the header's own wrapper specifically —
    // this is also why the sticky positioning rule above is written as
    // .shopify-section-group-header-group:has(header.header) rather than
    // the bare class selector.
    var group = document.querySelector('.shopify-section-group-header-group:has(header.header)');
    if (!group) return;

    function updateHeight() {
      var height = group.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--sticky-header-height', height + 'px');
    }

    updateHeight();

    // A ResizeObserver (rather than a one-time measurement) is required
    // here, not optional: the header wrapper's height isn't fixed — it
    // shrinks when initStickyHeader above toggles .header--condensed
    // during scroll (padding-block changes from var(--space-4) to
    // var(--space-2)), which changes the wrapper's rendered height.
    // Other sections (sections/product.liquid's sticky buy-box) read
    // --sticky-header-height to avoid sitting underneath this pinned
    // wrapper, so it must stay accurate through that transition, not
    // just reflect the height at page load.
    if (window.__strideHeaderHeightObserver) {
      window.__strideHeaderHeightObserver.disconnect();
    }

    if (window.ResizeObserver) {
      var resizeObserver = new ResizeObserver(updateHeight);
      resizeObserver.observe(group);
      window.__strideHeaderHeightObserver = resizeObserver;
    } else {
      if (window.__strideHeaderHeightResizeListener) {
        window.removeEventListener('resize', window.__strideHeaderHeightResizeListener);
      }
      window.__strideHeaderHeightResizeListener = updateHeight;
      window.addEventListener('resize', updateHeight);
    }
  }

  function initLocalizationForms(root) {
    root.querySelectorAll('[data-localization-form-submit]').forEach(function (select) {
      select.addEventListener('change', function () {
        select.form.submit();
      });
    });
  }

  var mobileNavCurrent = { panel: null, teardown: null };

  function syncMobileNavForViewport(matches) {
    var panel = mobileNavCurrent.panel;
    if (!panel) return;

    if (matches) {
      if (mobileNavCurrent.teardown) {
        mobileNavCurrent.teardown();
      }
      panel.classList.remove('is-open');
      panel.removeAttribute('inert');
      panel.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = '';
    } else if (!panel.classList.contains('is-open')) {
      panel.setAttribute('inert', '');
      panel.setAttribute('aria-hidden', 'true');
    }
  }

  var mobileNavQuery = window.matchMedia('(min-width: 750px)');
  mobileNavQuery.addEventListener('change', function (event) {
    syncMobileNavForViewport(event.matches);
  });

  function initMobileNav(root) {
    var trigger = root.querySelector('[data-mobile-nav-trigger]');
    var panel = root.querySelector('#MobileNavPanel');
    var overlay = root.querySelector('[data-mobile-nav-overlay]');
    var closeButton = root.querySelector('[data-mobile-nav-close]');
    if (!trigger || !panel || !overlay) return;

    mobileNavCurrent.panel = panel;
    syncMobileNavForViewport(mobileNavQuery.matches);

    if (panel.dataset.mobileNavInitialized) return;
    panel.dataset.mobileNavInitialized = 'true';

    var lastFocusedElement = null;

    function getFocusableElements() {
      var candidates = Array.from(
        panel.querySelectorAll('a[href], button:not([disabled]), input, select, textarea, summary, [tabindex]:not([tabindex="-1"])')
      );
      return candidates.filter(function (el) {
        var closedDetails = el.closest('details:not([open])');
        return !closedDetails || closedDetails.querySelector('summary') === el;
      });
    }

    function openPanel() {
      lastFocusedElement = document.activeElement;
      panel.classList.add('is-open');
      panel.removeAttribute('inert');
      panel.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      overlay.hidden = false;
      requestAnimationFrame(function () {
        overlay.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';

      var focusable = getFocusableElements();
      if (focusable.length > 0) focusable[0].focus();

      document.addEventListener('keydown', onKeydown);
    }

    function closePanel() {
      panel.classList.remove('is-open');
      if (!mobileNavQuery.matches) {
        panel.setAttribute('inert', '');
        panel.setAttribute('aria-hidden', 'true');
      }
      trigger.setAttribute('aria-expanded', 'false');
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);

      setTimeout(function () {
        overlay.hidden = true;
      }, 300);

      if (lastFocusedElement) lastFocusedElement.focus();
    }

    function onKeydown(event) {
      if (event.key === 'Escape') {
        closePanel();
        return;
      }

      if (event.key !== 'Tab') return;

      var focusable = getFocusableElements();
      if (focusable.length === 0) return;

      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (!panel.contains(document.activeElement)) {
        event.preventDefault();
        first.focus();
        return;
      }

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    mobileNavCurrent.teardown = function () {
      trigger.setAttribute('aria-expanded', 'false');
      overlay.classList.remove('is-open');
      overlay.hidden = true;
      document.removeEventListener('keydown', onKeydown);
    };

    trigger.addEventListener('click', openPanel);
    overlay.addEventListener('click', closePanel);
    if (closeButton) closeButton.addEventListener('click', closePanel);
  }

  // Additive only -- does not touch initStickyHeader/initMobileNav/
  // initLocalizationForms above. Toggles the predictive-search panel
  // rendered inside .header__search, reusing the same open/close +
  // click-outside + Escape-to-close shape initMobileNav already
  // established in this file, without sharing its focus-trap/body-scroll-
  // lock code (this is a small anchored dropdown, not a full-screen
  // panel, so that machinery doesn't apply here).
  function initSearchTrigger(root) {
    var trigger = root.querySelector('[data-search-trigger]');
    var panel = root.querySelector('[data-search-panel]');
    if (!trigger || !panel) return;

    if (panel.dataset.searchTriggerInitialized) return;
    panel.dataset.searchTriggerInitialized = 'true';

    var lastFocusedElement = null;

    function onDocumentClick(event) {
      if (panel.contains(event.target) || trigger.contains(event.target)) return;
      closePanel();
    }

    function onKeydown(event) {
      if (event.key === 'Escape') {
        closePanel();
      }
    }

    function openPanel() {
      lastFocusedElement = document.activeElement;
      panel.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');

      var input = panel.querySelector('[data-predictive-search-input]');
      if (input) input.focus();

      document.addEventListener('click', onDocumentClick);
      document.addEventListener('keydown', onKeydown);
    }

    function closePanel() {
      // Only steal focus back to lastFocusedElement when focus is still
      // inside this trigger/panel at close time (Escape, or toggling the
      // trigger closed) -- NOT when closed by clicking outside, since the
      // browser has already moved focus to whatever was clicked (e.g. a
      // different, independent predictive-search instance's own input on
      // sections/search.liquid) and forcing it back here would silently
      // eat that click.
      var shouldRestoreFocus =
        panel.contains(document.activeElement) || trigger.contains(document.activeElement);

      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      document.removeEventListener('click', onDocumentClick);
      document.removeEventListener('keydown', onKeydown);
      if (shouldRestoreFocus && lastFocusedElement) lastFocusedElement.focus();
    }

    trigger.addEventListener('click', function () {
      if (panel.hidden) {
        openPanel();
      } else {
        closePanel();
      }
    });
  }

  initStickyHeader(document);
  initStickyHeaderHeightVar();
  initLocalizationForms(document);
  initMobileNav(document);
  initSearchTrigger(document);

  document.addEventListener('shopify:section:load', function (event) {
    initStickyHeader(event.target);
    initStickyHeaderHeightVar();
    initLocalizationForms(event.target);
    initMobileNav(event.target);
    initSearchTrigger(event.target);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
