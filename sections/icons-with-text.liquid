{% comment %}
  Compact row of small icon + label pairs (shipping / returns / secure
  checkout style trust badges) — lighter-weight than Multicolumn, which
  is for full heading+paragraph feature blocks.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="icons-with-text full-width">
    {% if section.settings.heading != blank %}
      <h2 class="icons-with-text__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="icons-with-text__row icons-with-text__row--{{ section.settings.icon_size }} icons-with-text__row--text-{{ section.settings.text_size }}">
      {% for block in section.blocks %}
        <div class="icons-with-text__item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              class="icons-with-text__icon"
              src="{{ block.settings.image | image_url: width: 160 }}"
              srcset="{{ block.settings.image | image_url: width: 80 }} 80w, {{ block.settings.image | image_url: width: 160 }} 160w"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt=""
            >
          {% endif %}
          {% if block.settings.text != blank %}
            <span class="icons-with-text__text">{{ block.settings.text }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .icons-with-text {
    padding-block: var(--space-6);
    padding-inline: var(--space-4);
  }
  @media (min-width: 750px) {
    .icons-with-text {
      padding-inline: var(--space-6);
    }
  }
  .icons-with-text__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  /*
    Grid, not a centered flex row: with only 2-3 items, justify-content:
    center clusters them in the middle of a wide screen with a lot of
    dead space on both sides -- confirmed live as the "grouped in the
    center" complaint. auto-fit + minmax spreads whatever count of
    items there are across the FULL row width (same layout mechanism
    sections/multicolumn.liquid's grid already uses), and each column
    still shrinks to fit more items instead of overflowing.
  */
  .icons-with-text__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-6);
    max-width: 64rem;
    margin-inline: auto;
  }
  .icons-with-text__item {
    /* container-type lets .icons-with-text__icon size itself off THIS
       item's own rendered column width (cqw), the same auto-scaling
       approach as sections/multicolumn.liquid: 2-3 items render wide
       columns and a bigger icon, 6 items render narrow columns and a
       correspondingly smaller one, automatically, in step with however
       many blocks are actually on the row -- see that section's
       comment for the full reasoning. The Icon size setting still
       exists here to let a merchant bias the range up or down (small/
       medium/large each define a different clamp below), it just no
       longer pins one fixed px value regardless of block count. */
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .icons-with-text__row--small .icons-with-text__icon {
    width: clamp(3rem, 45cqw, 5rem);
    height: clamp(3rem, 45cqw, 5rem);
  }
  .icons-with-text__row--medium .icons-with-text__icon {
    width: clamp(4rem, 50cqw, 7rem);
    height: clamp(4rem, 50cqw, 7rem);
  }
  .icons-with-text__row--large .icons-with-text__icon {
    width: clamp(5rem, 55cqw, 9rem);
    height: clamp(5rem, 55cqw, 9rem);
  }
  .icons-with-text__icon {
    object-fit: contain;
  }
  .icons-with-text__row--text-small .icons-with-text__text {
    font-size: 0.75rem;
  }
  .icons-with-text__row--text-medium .icons-with-text__text {
    font-size: 0.875rem;
  }
  .icons-with-text__row--text-large .icons-with-text__text {
    font-size: 1.125rem;
  }
  .icons-with-text__text {
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.icons_with_text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "t:labels.icon_size",
      "options": [
        { "value": "small", "label": "t:options.icon_size.small" },
        { "value": "medium", "label": "t:options.icon_size.medium" },
        { "value": "large", "label": "t:options.icon_size.large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:labels.text_size",
      "options": [
        { "value": "small", "label": "t:options.icon_size.small" },
        { "value": "medium", "label": "t:options.icon_size.medium" },
        { "value": "large", "label": "t:options.icon_size.large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "t:general.icon_text_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.icons_with_text",
      "blocks": [{ "type": "icon" }, { "type": "icon" }, { "type": "icon" }]
    }
  ]
}
{% endschema %}
