{% comment %}
  Compact row of small icon + label pairs (shipping / returns / secure
  checkout style trust badges) — lighter-weight than Multicolumn, which
  is for full heading+paragraph feature blocks.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="icons-with-text full-width">
    {% if section.settings.heading != blank %}
      <h2 class="icons-with-text__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="icons-with-text__row">
      {% for block in section.blocks %}
        <div class="icons-with-text__item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              class="icons-with-text__icon"
              src="{{ block.settings.image | image_url: width: 80 }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt=""
            >
          {% endif %}
          {% if block.settings.text != blank %}
            <span class="icons-with-text__text">{{ block.settings.text }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .icons-with-text {
    padding-block: var(--space-6);
    padding-inline: var(--space-4);
  }
  @media (min-width: 750px) {
    .icons-with-text {
      padding-inline: var(--space-6);
    }
  }
  .icons-with-text__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .icons-with-text__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    max-width: 64rem;
    margin-inline: auto;
  }
  .icons-with-text__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    max-width: 10rem;
  }
  .icons-with-text__icon {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }
  .icons-with-text__text {
    font-size: 0.875rem;
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.icons_with_text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "t:general.icon_text_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.icons_with_text",
      "blocks": [{ "type": "icon" }, { "type": "icon" }, { "type": "icon" }]
    }
  ]
}
{% endschema %}
