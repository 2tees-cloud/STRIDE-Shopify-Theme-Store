{% comment %}
  This section is used in the password template to render the landing
  page shown when password protection is applied to a store. Adds the
  logo-or-shop-name block spec section 5.8 requires, mirroring the
  exact settings.logo-or-shop.name pattern already used in
  templates/gift_card.liquid rather than inventing a new one. Like
  sections/404.liquid, there is no other content on this page, so the
  section root spans the full viewport with its own block padding for
  vertical centering.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password full-width">
  <div class="password__content">
    <div class="password__logo">
      {% if settings.logo %}
        {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}
      {% else %}
        <p class="password__shop-name">{{ shop.name }}</p>
      {% endif %}
    </div>

    <h1 class="password__title">{{ 'password.title' | t }}</h1>

    {% if shop.password_message %}
      <p class="password__message">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password__form' %}
      {% if form.errors %}
        <div class="password__error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <label for="password-input" class="password__label">
        {{ 'password.password' | t }}
      </label>

      <div class="password__field">
        <input
          type="password"
          name="password"
          id="password-input"
          class="password__input"
          autocomplete="current-password"
          required
        >
        <button type="submit" class="password__submit">
          {{ 'password.enter' | t }}
        </button>
      </div>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .password {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    text-align: center;
  }
  @media (min-width: 750px) {
    .password {
      padding-inline: var(--space-6);
    }
  }
  .password__content {
    max-width: 24rem;
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }
  .password__logo {
    width: 100%;
  }
  .password__logo img {
    max-height: 3rem;
    width: auto;
    margin-inline: auto;
  }
  .password__shop-name {
    font-family: var(--font-header--family);
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    margin: 0;
  }
  .password__title {
    font-family: var(--font-header--family);
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin: 0;
  }
  .password__message {
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .password__form {
    width: 100%;
    text-align: left;
  }
  .password__label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 700;
  }
  .password__field {
    display: flex;
    gap: var(--space-2);
  }
  .password__input {
    flex-grow: 1;
    min-height: 24px;
    border: 1px solid var(--color-foreground-muted);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    padding: var(--space-3);
    border-radius: var(--style-border-radius-inputs);
  }
  .password__submit {
    flex-shrink: 0;
    min-height: 24px;
    border: 1px solid var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
    padding: var(--space-3) var(--space-5);
    cursor: pointer;
    font-weight: 700;
    border-radius: var(--style-border-radius-inputs);
  }
  .password__error {
    color: var(--color-urgency);
    text-align: left;
    margin: 0 0 var(--space-2);
  }
  @media (max-width: 480px) {
    .password__field {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
