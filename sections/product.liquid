{% comment %}
  Main product section. Two-column layout: media gallery (left/top) and
  a scrollable info column (right/bottom) containing every block a
  merchant configures, all inside the ONE product form this section
  owns. Blocks render via {% content_for 'blocks' %} (this theme's
  established theme-blocks convention — see sections/footer.liquid for
  the sibling pattern) — do NOT reintroduce the older
  {% for block in section.blocks %}{% case block.type %} pattern.

  Gallery in this task is minimal (all media, first active) — Task 3
  adds zoom and sticky-buy-box layout polish. Variant-driven live
  updates (price, sold-out, gallery active image, URL) are Task 2.
{% endcomment %}

<div class="product full-width">
  <div class="product__gallery">
    {% if product.media.size > 0 %}
      {% for media in product.media %}
        <div class="product__gallery-item{% if forloop.first %} is-active{% endif %}" data-product-media-id="{{ media.id }}">
          {% if media.media_type == 'image' %}
            <img
              src="{{ media | image_url: width: 1600 }}"
              srcset="{{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1600 }} 1600w"
              sizes="(min-width: 750px) 50vw, 100vw"
              width="{{ media.width }}"
              height="{{ media.height }}"
              alt="{{ media.alt | default: product.title | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            >
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <div class="product__gallery-item is-active product__gallery-item--placeholder"></div>
    {% endif %}
  </div>

  <div class="product__info">
    {% form 'product', product, data-add-to-cart-form: true %}
      {% content_for 'blocks' %}
      {% comment %}
        {{ form | payment_button }} must be called here, not inside
        blocks/buy-buttons.liquid — the form tag's block-scoped `form`
        variable does not stay in scope across the content_for 'blocks'
        boundary into a theme-block file (verified live: it silently
        renders empty there, and theme-check flags it statically as
        an UndefinedObject).
      {% endcomment %}
      {{ form | payment_button }}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .product {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 750px) {
    .product {
      padding-inline: var(--space-6);
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .product__info {
      /*
        top is intentionally NOT var(--space-4) (16px), despite that
        being the plan's literal suggestion. sections/header.liquid's
        sticky header (.shopify-section-group-header-group, top: 0,
        z-index: 10) is a separate sticky element that stays pinned to
        the viewport for the whole page scroll. Its own rendered
        height is ~4rem (64px) expanded (padding-block: var(--space-4)
        = 32px combined + ~32px content row from the 2rem icon svgs)
        and ~3rem (48px) condensed (padding-block: var(--space-2)).
        A 16px sticky offset is smaller than either, so the top of
        this panel would tuck in behind the opaque header instead of
        resting below it. Using space-8 + space-2 (72px) clears the
        worst case (expanded, 64px) with an 8px margin. This is a
        static calculation, not a live-measured value — see the task
        report for the live-verification gap.
      */
      position: sticky;
      top: calc(var(--space-8) + var(--space-2));
      align-self: start;
      max-height: calc(100svh - var(--space-8) - var(--space-4));
      overflow-y: auto;
    }
  }
  .product__gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .product__gallery-item {
    display: none;
  }
  .product__gallery-item.is-active {
    display: block;
  }
  .product__gallery-item img {
    width: 100%;
    height: auto;
  }
  .product__gallery-item--placeholder {
    aspect-ratio: 1 / 1;
    background-color: var(--color-background-alt);
  }
  .product__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
