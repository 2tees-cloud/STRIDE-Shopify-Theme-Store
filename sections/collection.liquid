{% comment %}
  Collection page: header (title/description/image), product grid,
  empty-collection message, pagination. Faceted filtering and sorting
  are added on top of this in Task 2 (a form above the grid) and
  Task 3 (AJAX enhancement) — this task ships the fully-functional
  base experience those build on.
{% endcomment %}

<div class="collection full-width">
  <div class="collection__header">
    {% if collection.image %}
      <div class="collection__image">
        {% render 'image', image: collection.image, class: 'collection__image-inner' %}
      </div>
    {% endif %}
    <h1 class="collection__title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection__description">{{ collection.description }}</div>
    {% endif %}
  </div>

  {% paginate collection.products by 24 %}
    {% render 'collection-filters', collection: collection, section: section %}

    {% comment %}
      Result-count announcement for Task 3's AJAX enhancement
      (assets/collection-filters.js). Stays outside the swapped grid/empty
      subtree so it survives each AJAX swap intact; the JS only ever
      writes its textContent, never re-renders it. The translated
      template is rendered server-side (count: '__COUNT__' is a literal
      placeholder token, not a real count) so the JS substitutes the
      actual count into an already-localized string instead of hardcoding
      English text in the .js file — same "data-*-text" pattern
      blocks/buy-buttons.liquid uses for data-add-to-cart-text.
    {% endcomment %}
    <div
      class="visually-hidden"
      data-collection-live-region
      data-results-count-template="{{ 'collection.results_count' | t: count: '__COUNT__' | escape }}"
      role="status"
      aria-live="polite"
    ></div>

    {% comment %}
      data-collection-results wraps the grid/empty-state AND the
      pagination nav together, and is what Task 3's AJAX enhancement
      actually swaps as a single unit on each fetch — not just
      data-collection-grid on its own. Filtering/sorting can change the
      total page count (paginate.pages), so the pagination nav has to be
      replaced in lockstep with the grid; swapping data-collection-grid
      alone would leave a stale pagination nav (wrong page links, or a
      nav still showing when the new result set no longer has multiple
      pages) sitting next to a freshly-swapped grid.
    {% endcomment %}
    <div data-collection-results>
      {% if collection.products.size > 0 %}
        <div class="collection__grid" data-collection-grid>
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="collection__pagination" aria-label="{{ 'collection.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% else %}
        <p class="collection__empty">{{ 'collection.empty' | t }}</p>
      {% endif %}
    </div>
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
  }
  @media (min-width: 750px) {
    .collection {
      padding-inline: var(--space-6);
    }
  }
  .collection__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto var(--space-6);
  }
  .collection__image {
    max-width: 20rem;
    margin: 0 auto var(--space-4);
  }
  .collection__title {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-2);
  }
  .collection__description {
    color: var(--color-foreground-muted);
  }
  .collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 750px) {
    .collection__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
  }
  .collection__pagination {
    margin-top: var(--space-8);
    display: flex;
    justify-content: center;
  }
  .collection__pagination a {
    min-width: 24px;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
  }
  .collection__empty {
    text-align: center;
    color: var(--color-foreground-muted);
    padding-block: var(--space-8);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
