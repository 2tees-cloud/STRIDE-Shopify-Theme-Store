{% comment %}
  Shopify's native contact form, usable on any page/template -- the
  same form Shopify's `contact` form type provides, which
  sections/page-contact.liquid already uses on the dedicated contact
  page. That page keeps its own copy (plus the address/phone/map panel
  next to it) rather than rendering this section, since it needs the
  two-column layout tied to its own address/phone settings; this
  section is the plain, address-free version for dropping the form
  anywhere else (e.g. the homepage).
{% endcomment %}

<div class="contact-form-section full-width">
  {% if section.settings.heading != blank %}
    <h2 class="contact-form-section__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% form 'contact', class: 'contact-form-section__form' %}
    {% if form.posted_successfully? %}
      <p class="form-status form-status--success">{{ 'contact.form.success' | t }}</p>
    {% endif %}

    {% if form.errors %}
      <div class="form-status form-status--error">
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    <div class="field">
      <label for="ContactFormSectionName-{{ section.id }}">{{ 'contact.form.name' | t }}</label>
      <input
        type="text"
        id="ContactFormSectionName-{{ section.id }}"
        name="contact[name]"
        autocomplete="name"
        value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
      >
    </div>

    <div class="field">
      <label for="ContactFormSectionEmail-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
      <input
        type="email"
        id="ContactFormSectionEmail-{{ section.id }}"
        name="contact[email]"
        autocomplete="email"
        autocapitalize="off"
        value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
        required
      >
    </div>

    <div class="field">
      <label for="ContactFormSectionMessage-{{ section.id }}">{{ 'contact.form.message' | t }}</label>
      <textarea rows="5" id="ContactFormSectionMessage-{{ section.id }}" name="contact[body]">{% if form.body %}{{ form.body }}{% endif %}</textarea>
    </div>

    <button type="submit">{{ 'contact.form.submit' | t }}</button>
  {% endform %}
</div>

{% stylesheet %}
  .contact-form-section {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    max-width: 32rem;
    margin-inline: auto;
  }
  @media (min-width: 750px) {
    .contact-form-section {
      padding-inline: var(--space-6);
    }
  }
  .contact-form-section__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .contact-form-section__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-form-section__form .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .contact-form-section__form button {
    min-height: 24px;
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-foreground);
    color: var(--color-background);
    border: none;
    font-weight: 700;
    cursor: pointer;
  }
  .form-status--success {
    color: var(--color-foreground);
  }
  .form-status--error {
    color: var(--color-urgency);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact_form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get in touch"
    }
  ],
  "presets": [{ "name": "t:general.contact_form" }]
}
{% endschema %}
