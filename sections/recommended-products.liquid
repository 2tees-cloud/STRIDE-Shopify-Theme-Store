{% comment %}
  Product-page-only section: "You may also like" / "Pair it with",
  powered by Shopify's native recommendation engine (not a manual
  product list). Fetched async via the Section Rendering API so it
  never blocks the product page's own initial render — this exact
  data-url/IntersectionObserver pattern is Shopify's own documented
  reference implementation, not invented here.
  https://shopify.dev/docs/storefronts/themes/product-merchandising/recommendations/related-products
{% endcomment %}

<div
  class="recommended-products full-width"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.item_limit }}&intent={{ section.settings.intent }}"
  data-recommended-products
>
  {% if recommendations.performed? and recommendations.products_count > 0 %}
    <h2 class="recommended-products__heading">
      {% if recommendations.intent == 'related' %}
        {{ section.settings.heading }}
      {% elsif recommendations.intent == 'complementary' %}
        {{ section.settings.complementary_heading }}
      {% endif %}
    </h2>
    <div class="recommended-products__grid">
      {% for product in recommendations.products %}
        {% render 'product-card', product: product, image_ratio: section.settings.image_ratio %}
      {% endfor %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .recommended-products {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
  }
  @media (min-width: 750px) {
    .recommended-products {
      padding-inline: var(--space-6);
    }
  }
  .recommended-products__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .recommended-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 750px) {
    .recommended-products__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
  }
{% endstylesheet %}

{% javascript %}
  function initRecommendedProducts(root) {
    root.querySelectorAll('[data-recommended-products]').forEach(function (section) {
      if (section.dataset.recommendedProductsInitialized) return;
      section.dataset.recommendedProductsInitialized = 'true';

      var observer = new IntersectionObserver(function (entries, obs) {
        if (!entries[0].isIntersecting) return;
        obs.unobserve(section);

        fetch(section.dataset.url)
          .then(function (response) { return response.text(); })
          .then(function (text) {
            var html = document.createElement('div');
            html.innerHTML = text;
            var fresh = html.querySelector('[data-recommended-products]');
            if (fresh && fresh.innerHTML.trim().length) {
              section.innerHTML = fresh.innerHTML;
            }
          })
          .catch(function (error) {
            console.error(error);
          });
      }, { rootMargin: '0px 0px 200px 0px' });

      observer.observe(section);
    });
  }

  initRecommendedProducts(document);
  document.addEventListener('shopify:section:load', function (event) {
    initRecommendedProducts(event.target);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.recommended_products",
  "settings": [
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "landscape", "label": "t:options.image_ratio.landscape" },
        { "value": "adapt", "label": "t:options.image_ratio.adapt" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:labels.recommendation_intent",
      "options": [
        { "value": "related", "label": "t:options.recommendation_intent.related" },
        { "value": "complementary", "label": "t:options.recommendation_intent.complementary" }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "complementary_heading",
      "label": "t:labels.complementary_heading",
      "default": "Pair it with"
    },
    {
      "type": "range",
      "id": "item_limit",
      "label": "t:labels.item_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [{ "name": "t:general.recommended_products" }]
}
{% endschema %}
