{% comment %}
  Simple centered heading + text + optional button. General-purpose
  content section for the space between more specialized ones (hero,
  collection grid, etc.) — the "Rich text" section most theme section
  libraries ship as a baseline building block.
{% endcomment %}

{% if section.settings.heading != blank or section.settings.text != blank or section.settings.cta_text != blank %}
  <div class="rich-text full-width">
    {% if section.settings.heading != blank %}
      <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="rich-text__text">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_link | escape }}" class="rich-text__cta">{{ section.settings.cta_text }}</a>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .rich-text {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  @media (min-width: 750px) {
    .rich-text {
      padding-inline: var(--space-6);
    }
  }
  .rich-text__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0;
  }
  .rich-text__text {
    color: var(--color-foreground-muted);
    line-height: 1.6;
  }
  .rich-text__text :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--font-header--family);
    color: var(--color-foreground);
  }
  .rich-text__text p {
    margin: 0 0 var(--space-2);
  }
  .rich-text__text p:last-child {
    margin-bottom: 0;
  }
  .rich-text__cta {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-foreground);
    color: var(--color-background);
    text-decoration: none;
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.rich_text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:labels.cta_text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    }
  ],
  "presets": [{ "name": "t:general.rich_text" }]
}
{% endschema %}
