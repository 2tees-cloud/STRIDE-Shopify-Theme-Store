{% comment %}
  A curated grid of collections (each an image + title, linking
  through) — distinct from sections/collections.liquid, which is the
  real /collections listing page showing every collection in the
  store. Each block picks one collection explicitly, since classic
  section schema has no native "list of collections" picker setting.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="collection-list-grid full-width">
    {% if section.settings.heading != blank %}
      <h2 class="collection-list-grid__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="collection-list-grid__grid">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          {% assign featured_collection = block.settings.collection %}
          <a href="{{ featured_collection.url }}" class="collection-list-grid__card" {{ block.shopify_attributes }}>
            <div class="collection-list-grid__media">
              {% if featured_collection.featured_image %}
                {% render 'image', image: featured_collection.featured_image, class: 'collection-list-grid__image', width: 600 %}
              {% else %}
                <div class="collection-list-grid__image collection-list-grid__image--placeholder"></div>
              {% endif %}
            </div>
            <h3 class="collection-list-grid__title">{{ featured_collection.title }}</h3>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .collection-list-grid {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }
  @media (min-width: 750px) {
    .collection-list-grid {
      padding-inline: var(--space-6);
    }
  }
  .collection-list-grid__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .collection-list-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 750px) {
    .collection-list-grid__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
  }
  .collection-list-grid__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-foreground);
  }
  .collection-list-grid__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
  }
  /*
    render 'image' puts the class on the .image wrapper div, not the
    <img> itself -- object-fit/object-position only affect a replaced
    element, so they have to target the nested img (which the shared
    .image > img rule otherwise leaves at width:100%; height:auto,
    letting a taller-than-square photo overflow the div and get
    clipped at the bottom by its overflow:hidden instead of cropped
    from a chosen focal point).
  */
  .collection-list-grid__image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  .collection-list-grid__image--placeholder {
    background-color: var(--color-background-alt);
  }
  .collection-list-grid__title {
    font-family: var(--font-header--family);
    font-size: 1.125rem;
    font-weight: 400;
    margin: 0;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list_grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by collection"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "t:general.collection_item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:general.collection_list_grid",
      "blocks": [{ "type": "collection_item" }, { "type": "collection_item" }, { "type": "collection_item" }]
    }
  ]
}
{% endschema %}
