{% comment %}
  A curated grid of collections (each an image + title, linking
  through) — distinct from sections/collections.liquid, which is the
  real /collections listing page showing every collection in the
  store. Each block picks one collection explicitly, since classic
  section schema has no native "list of collections" picker setting.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="collection-list-grid full-width">
    {% if section.settings.heading != blank %}
      <h2 class="collection-list-grid__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="collection-list-grid__grid">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          {% assign featured_collection = block.settings.collection %}
          <a href="{{ featured_collection.url }}" class="collection-list-grid__card" {{ block.shopify_attributes }}>
            <div class="collection-list-grid__media">
              {% if featured_collection.featured_image %}
                {% render 'image', image: featured_collection.featured_image, class: 'collection-list-grid__image', width: 600 %}
              {% else %}
                <div class="collection-list-grid__image collection-list-grid__image--placeholder"></div>
              {% endif %}
            </div>
            <h3 class="collection-list-grid__title">{{ featured_collection.title }}</h3>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .collection-list-grid {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }
  @media (min-width: 750px) {
    .collection-list-grid {
      padding-inline: var(--space-6);
    }
  }
  .collection-list-grid__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .collection-list-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  /*
    The 3-block preset is exactly the count that wraps to a lone card on
    a 2-column grid -- stuck alone on the left edge with empty space
    beside it. Give a trailing lone card the full row but cap its own
    width to one column's share and center it, rather than stretching
    its image full-bleed or leaving it lopsided. Merchants can add up
    to 8 cards, so this also covers any other odd-at-mobile count, not
    just the 3-card preset.
  */
  .collection-list-grid__grid .collection-list-grid__card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    max-width: calc(50% - var(--space-4) / 2);
    margin-inline: auto;
  }
  @media (min-width: 750px) {
    .collection-list-grid__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
    .collection-list-grid__grid .collection-list-grid__card:last-child:nth-child(odd) {
      grid-column: auto;
      max-width: none;
      margin-inline: 0;
    }
    /* Same idea at 4 columns: only a count like 5 (4 + 1) wraps to a
       lone trailing card here -- 3 shares its first row with room to
       spare, which reads as a normal partial row, not a stranded one. */
    .collection-list-grid__grid .collection-list-grid__card:last-child:nth-child(4n + 1) {
      grid-column: 1 / -1;
      max-width: calc(100% / 4 - var(--space-6) * 3 / 4);
      margin-inline: auto;
    }
  }
  .collection-list-grid__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-foreground);
  }
  .collection-list-grid__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
  }
  /*
    render 'image' puts the class on the .image wrapper div, not the
    <img> itself -- object-fit/object-position only affect a replaced
    element, so they have to target the nested img (which the shared
    .image > img rule otherwise leaves at width:100%; height:auto,
    letting a taller-than-square photo overflow the div and get
    clipped at the bottom by its overflow:hidden instead of cropped
    from a chosen focal point).
  */
  /*
    .image.collection-list-grid__image (both classes), not just
    .collection-list-grid__image, so this beats the shared
    .image > img { height: auto } rule on specificity (0,0,2,1 vs
    0,0,1,1) rather than depending on which stylesheet happens to be
    concatenated later -- the two have equal specificity otherwise, so
    source order was silently deciding the winner and height: auto
    was winning, undoing the cover crop below by letting the img
    render at its own natural (taller-than-square) height regardless.
  */
  .image.collection-list-grid__image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  .collection-list-grid__image--placeholder {
    background-color: var(--color-background-alt);
  }
  .collection-list-grid__title {
    font-family: var(--font-header--family);
    font-size: 1.125rem;
    font-weight: 400;
    margin: 0;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list_grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by collection"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "t:general.collection_item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:general.collection_list_grid",
      "blocks": [{ "type": "collection_item" }, { "type": "collection_item" }, { "type": "collection_item" }]
    }
  ]
}
{% endschema %}
