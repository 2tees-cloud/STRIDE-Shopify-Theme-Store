{% comment %}
  Full-width, one-slide-at-a-time image + text slideshow (not several
  cards peeking side by side -- that layout doesn't reliably overflow
  once the slide count is small enough to fit a wide screen at once,
  which left Autoplay and the arrows with nothing to actually scroll;
  see the .carousel__track comment below). CSS scroll-snap does the
  actual scrolling/snapping (works via touch/trackpad with zero JS);
  the javascript block below wires the two arrow buttons to scrollBy
  one slide's width (looping past the last/first slide) and, when
  Autoplay is on, advances on a timer -- paused on hover/focus per WCAG
  2.2.2 and skipped entirely under prefers-reduced-motion, matching
  this theme's existing motion-reduction handling elsewhere (e.g.
  sections/hero-colorway.liquid's own reduced-motion media query).

  IMPORTANT: never spell out the literal stylesheet/javascript/schema
  tag delimiters inside a comment in this file (or any section file) --
  Shopify's asset compiler locates each block with a plain text search
  for those tokens, not a nested-aware parser, so an earlier literal
  mention becomes the block's (wrong) start and sweeps everything after
  it -- including the real markup and CSS -- into the JS bundle as
  broken syntax. Confirmed live: this exact mistake in an early draft of
  this file corrupted the compiled script bundle with raw CSS/HTML text
  and threw "Unexpected identifier" errors in the browser console.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="carousel full-width">
    {% if section.settings.heading != blank %}
      <h2 class="carousel__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="carousel__viewport" {% if section.settings.autoplay and section.blocks.size > 1 %}data-autoplay="{{ section.settings.autoplay_speed }}"{% endif %}>
      <div class="carousel__track" data-carousel-track>
        {% for block in section.blocks %}
          <div class="carousel__slide" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                class="carousel__image"
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(min-width: 750px) 40vw, 80vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
              >
            {% endif %}
            {% if block.settings.heading != blank %}
              <h3 class="carousel__slide-heading">{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link | escape }}" class="carousel__slide-link">
                <span class="visually-hidden">{{ block.settings.heading }}</span>
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="{{ 'labels.previous_slide' | t }}">
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </button>
        <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="{{ 'labels.next_slide' | t }}">
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </button>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .carousel {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    content-visibility: auto;
    contain-intrinsic-size: auto 500px;
  }
  @media (min-width: 750px) {
    .carousel {
      padding-inline: var(--space-6);
    }
  }
  .carousel__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .carousel__viewport {
    /*
      .carousel itself is full-width (spans the entire browser
      viewport, not just the page's normal content column) -- matches
      every other section's own constrained content width instead of
      genuinely spanning the raw viewport, which is also what keeps the
      arrows (position: absolute against this element) anchored next to
      the actual slides instead of the far edges of a wide screen.
    */
    position: relative;
    max-width: 64rem;
    margin-inline: auto;
  }
  .carousel__track {
    /*
      One full-width slide per view, not several peeking side by side:
      a multi-up "peek" row (each slide a fixed ~20rem regardless of
      viewport) doesn't overflow at all once there are only as many
      slides as comfortably fit a wide screen -- 3 slides at that width
      fit entirely inside this now-constrained 64rem viewport with
      nothing left to scroll to, so Autoplay and the arrows had nothing
      to actually move (confirmed live: a merchant's real 3-slide
      carousel just sat static). Every slide being 100% of the track's
      own width guarantees real, scrollable content the moment there
      are 2+ slides, independent of viewport width or block count.
    */
    /*
      scroll-behavior here, not the JS scrollBy/scrollTo calls' own
      `behavior: 'smooth'` option -- confirmed live that passing
      behavior:'smooth' in the JS call on a scroll-snap-type: x
      mandatory container silently does nothing at all (scrollLeft
      never changes, not even after waiting seconds), while the exact
      same scrollBy call with NO behavior option, on an element that
      has this CSS property instead, animates correctly. The JS below
      relies on that split: plain scrollBy() calls inherit smooth from
      here, and the one place that needs an instant (non-animated) jump
      explicitly overrides behavior to 'instant' rather than getting it
      from this property.
    */
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
  }
  .carousel__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .carousel__image {
    /*
      A fixed aspect-ratio (rather than height:auto) keeps every slide
      the same height regardless of that slide's own image proportions
      -- with one full-width slide visible at a time, differently
      shaped images would otherwise change the carousel's height as it
      advances, shifting the page content below it on every autoplay
      tick.
    */
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 80%;
    display: block;
  }
  .carousel__slide-heading {
    font-family: var(--font-header--family);
    font-size: 1.125rem;
    margin: var(--space-2) 0 0;
  }
  .carousel__slide-link {
    position: absolute;
    inset: 0;
  }
  .carousel__arrow {
    display: none;
  }
  @media (min-width: 750px) {
    .carousel__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      width: 2.5rem;
      height: 2.5rem;
      min-width: 24px;
      min-height: 24px;
      border-radius: 50%;
      border: 1px solid var(--color-foreground-muted);
      background-color: var(--color-surface);
      color: var(--color-foreground);
      cursor: pointer;
      z-index: 1;
    }
    .carousel__arrow svg {
      width: 1rem;
    }
    /*
      Inset over the slide image itself, not protruding outside the
      viewport's edges -- that outside-the-edge positioning was for the
      old multi-slide "peek" row, where the arrows sat in the gap
      between the track and the constrained viewport's own boundary.
      With one full-bleed slide filling the whole viewport, there is no
      such gap to sit in; overlaying the arrows on the image (the
      conventional slideshow pattern) is what actually places them next
      to visible content now.
    */
    .carousel__arrow--prev {
      left: var(--space-4);
      transform: translateY(-50%) rotate(180deg);
    }
    .carousel__arrow--next {
      right: var(--space-4);
    }
  }
{% endstylesheet %}

{% javascript %}
  function initCarousel(root) {
    root.querySelectorAll('.carousel__viewport').forEach(function (viewport) {
      var track = viewport.querySelector('[data-carousel-track]');
      var prev = viewport.querySelector('[data-carousel-prev]');
      var next = viewport.querySelector('[data-carousel-next]');
      if (!track) return;

      // Looping matters specifically for autoplay: without it, autoplay
      // would just stall at the last slide instead of continuing to
      // cycle, which is what "autoplay" is expected to do. The
      // prev/next buttons loop the same way for consistency, not just
      // because autoplay needs it.
      //
      // Absolute index math, not a relative scrollBy(distance *
      // direction): a manual click restarts autoplay's timer (see
      // startAutoplay() below), so a click landing right as an autoplay
      // tick was also about to fire can call this twice in close
      // succession -- if the first call's smooth animation hadn't
      // settled yet, a second relative scrollBy would add its delta to
      // whatever mid-animation position scrollLeft happened to be at
      // that instant, not the intended slide, drifting further off with
      // every overlap. Recomputing the CURRENT slide index from
      // scrollLeft on every call (rounding to the nearest one) instead
      // self-corrects back to a real slide position each time, however
      // unsettled scrollLeft was when this ran.
      function scrollByOneSlide(direction) {
        var distance = track.clientWidth;
        var slideCount = Math.round(track.scrollWidth / distance);
        var currentIndex = Math.round(track.scrollLeft / distance);
        var nextIndex = currentIndex + direction;
        var isWrap = nextIndex < 0 || nextIndex >= slideCount;

        if (nextIndex < 0) nextIndex = slideCount - 1;
        if (nextIndex >= slideCount) nextIndex = 0;

        // The wrap-around jump explicitly forces behavior: 'instant',
        // overriding the smooth scroll-behavior set on .carousel__track
        // in CSS: confirmed live that animating all the way back across
        // the whole track fights this element's own
        // scroll-snap-type: x mandatory (a snap container "settling"
        // across every intermediate snap point on one long smooth
        // animation, rather than jumping straight to the target) and
        // the scroll simply never completes -- autoplay would tick
        // forever without visibly moving past the last slide. An
        // instant reset avoids that fight, and is the standard UX for
        // an infinite carousel's wrap point anyway (no theme smooth-
        // scrolls all the way back across every slide just to loop).
        //
        // Every non-wrap jump has no behavior option, on purpose --
        // it inherits smooth from .carousel__track's own CSS
        // scroll-behavior (passing behavior: 'smooth' directly in this
        // call instead silently does nothing on this scroll-snap
        // container, confirmed live).
        track.scrollTo({
          left: nextIndex * distance,
          behavior: isWrap ? 'instant' : undefined
        });
      }

      // autoplaySeconds comes from the Autoplay speed setting, rendered
      // as data-autoplay only when the merchant's Autoplay checkbox is
      // on -- so a missing/blank attribute here already means "off",
      // same as the reduced-motion check right after it.
      var autoplaySeconds = parseFloat(viewport.dataset.autoplay);
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var autoplayTimer = null;

      function stopAutoplay() {
        if (autoplayTimer) clearInterval(autoplayTimer);
        autoplayTimer = null;
      }

      function startAutoplay() {
        if (!autoplaySeconds || reducedMotion) return;
        stopAutoplay();
        autoplayTimer = setInterval(function () {
          scrollByOneSlide(1);
        }, autoplaySeconds * 1000);
      }

      if (prev) {
        prev.addEventListener('click', function () {
          scrollByOneSlide(-1);
          startAutoplay(); // restarts the countdown rather than leaving a manual click about to be interrupted moments later
        });
      }
      if (next) {
        next.addEventListener('click', function () {
          scrollByOneSlide(1);
          startAutoplay();
        });
      }

      if (autoplaySeconds && !reducedMotion) {
        startAutoplay();
        // WCAG 2.2.2 (Pause, Stop, Hide): auto-advancing content must be
        // pausable. Hover covers mouse users, focusin/focusout covers
        // keyboard users tabbing to a slide's own link -- relatedTarget
        // is checked so tabbing from one slide's link to the next
        // doesn't restart autoplay in the gap between the two focus
        // events.
        viewport.addEventListener('mouseenter', stopAutoplay);
        viewport.addEventListener('mouseleave', startAutoplay);
        viewport.addEventListener('focusin', stopAutoplay);
        viewport.addEventListener('focusout', function (event) {
          if (!viewport.contains(event.relatedTarget)) startAutoplay();
        });
      }
    });
  }

  initCarousel(document);
  document.addEventListener('shopify:section:load', function (event) {
    initCarousel(event.target);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:labels.autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "t:labels.autoplay_speed_info"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.carousel_slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.carousel",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
