{% comment %}
  Article detail page: header (image/title/date/author), full content
  (rich-text typography reuses blocks/product-description.liquid's
  conventions), paginated comment list, and a comment form with real
  success/error messaging.

  form.posted_successfully? was confirmed against Shopify's Liquid docs
  (objects/form): it's a general `form` object property, not called out
  as exclusive to any particular form type the way form.name or
  form.password_needed are, so it applies to the new_comment form the
  same way it already does to the customer/contact forms elsewhere in
  this theme (blocks/newsletter-signup.liquid, sections/page-contact.liquid).

  Per spec: "a working comment submit flow (success/error messaging)
  without requiring moderation to function." That's about the FORM
  working regardless of the blog's moderation setting, not about
  moderation being off — so when blog.moderated? is true, the success
  message says the comment is awaiting approval instead of implying it's
  live immediately.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

<div class="article full-width">
  <header class="article__header">
    {% if article.image %}
      <div class="article__hero">
        {% render 'image', image: article.image, class: 'article__hero-image', width: 1600 %}
      </div>
    {% endif %}
    <h1 class="article__title">{{ article.title }}</h1>
    {% assign date = article.published_at | time_tag: format: 'date' %}
    <p class="article__meta">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
  </header>

  <div class="article__content">
    {{ article.content }}
  </div>

  {% if blog.comments_enabled? %}
    <section class="article-comments" id="comments">
      <h2 class="article-comments__heading">{{ 'blog.article_comments' | t }}</h2>

      {% paginate article.comments by 10 %}
        {% if article.comments.size > 0 %}
          <ul class="article-comments__list">
            {% for comment in article.comments %}
              <li class="article-comments__item">
                <p class="article-comments__author">{{ comment.author }}</p>
                <p class="article-comments__date">{{ comment.created_at | time_tag: format: 'date' }}</p>
                <p class="article-comments__body">{{ comment.content }}</p>
              </li>
            {% endfor %}
          </ul>

          {% if paginate.pages > 1 %}
            <nav class="article-comments__pagination" aria-label="{{ 'blog.pagination' | t }}">
              {{ paginate | default_pagination: anchor: 'comments' }}
            </nav>
          {% endif %}
        {% else %}
          <p class="article-comments__empty">{{ 'blog.comments_empty' | t }}</p>
        {% endif %}
      {% endpaginate %}

      {% form 'new_comment', article, class: 'article-comments__form' %}
        {% if form.posted_successfully? %}
          {% if blog.moderated? %}
            <p class="article-comments__success">{{ 'blog.comment_success_moderated' | t }}</p>
          {% else %}
            <p class="article-comments__success">{{ 'blog.comment_success' | t }}</p>
          {% endif %}
        {% else %}
          <h3 class="article-comments__form-title">{{ 'blog.comment_form_title' | t }}</h3>

          {% if form.errors %}
            <div class="article-comments__errors">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="article-comments__field">
            <label for="CommentAuthor">{{ 'blog.comment_form_name' | t }}</label>
            <input
              type="text"
              name="comment[author]"
              id="CommentAuthor"
              autocomplete="name"
              value="{% if form.author %}{{ form.author | escape }}{% endif %}"
              required
            >
          </div>

          <div class="article-comments__field">
            <label for="CommentEmail">{{ 'blog.comment_form_email' | t }}</label>
            <input
              type="email"
              name="comment[email]"
              id="CommentEmail"
              autocomplete="email"
              value="{% if form.email %}{{ form.email | escape }}{% endif %}"
              required
            >
          </div>

          <div class="article-comments__field">
            <label for="CommentBody">{{ 'blog.comment_form_body' | t }}</label>
            <textarea name="comment[body]" id="CommentBody" rows="5" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="article-comments__submit">{{ 'blog.comment_form_submit' | t }}</button>
        {% endif %}
      {% endform %}
    </section>
  {% endif %}
</div>

{% stylesheet %}
  .article {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    max-width: 48rem;
    margin-inline: auto;
  }
  @media (min-width: 750px) {
    .article {
      padding-inline: var(--space-6);
    }
  }
  .article__header {
    margin-bottom: var(--space-6);
  }
  .article__hero {
    margin: 0 0 var(--space-6);
  }
  .article__hero-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
  }
  /*
    .image.article__hero-image (both classes, matching render 'image''s
    wrapper), not just .article__hero-image, so this reliably beats
    the shared .image > img { height: auto } rule on specificity
    (0,0,2,1 vs 0,0,1,1) instead of leaving the winner to source
    order -- see the near-identical fix on .collection-list-grid__image
    and .article-card__image for the full explanation.
  */
  .image.article__hero-image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  .article__title {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-2);
  }
  .article__meta {
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .article__content {
    color: var(--color-foreground);
    line-height: 1.6;
  }
  .article__content :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--font-header--family);
    margin: var(--space-4) 0 var(--space-2);
  }
  .article__content :is(ul, ol) {
    padding-inline-start: var(--space-5);
  }
  .article__content p {
    margin: 0 0 var(--space-4);
  }
  .article__content img {
    max-width: 100%;
    height: auto;
  }
  .article-comments {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .article-comments__heading {
    font-family: var(--font-header--family);
    font-size: 1.5rem;
    margin: 0 0 var(--space-4);
  }
  .article-comments__list {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .article-comments__item {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .article-comments__author {
    font-weight: 700;
    margin: 0;
  }
  .article-comments__date {
    color: var(--color-foreground-muted);
    font-size: 0.875rem;
    margin: 0 0 var(--space-2);
  }
  .article-comments__body {
    margin: 0;
  }
  .article-comments__empty {
    color: var(--color-foreground-muted);
    margin: 0 0 var(--space-6);
  }
  .article-comments__pagination {
    margin: 0 0 var(--space-6);
    display: flex;
    justify-content: center;
  }
  /*
    default_pagination wraps every entry in a <span> (class "page",
    "page current", "deco", "next", "prev"), but only the clickable ones
    contain an <a> -- the current page and the "…" ellipsis are bare
    text directly inside their span. Sizing only the <a> (as this rule
    used to) left those two with no padding and no vertical centering,
    rendering "current" as a thin sliver next to its padded siblings
    (see sections/collection.liquid for the live-confirmed measurements
    behind this fix). Sizing the outer span uniformly, and having the
    <a> just fill it, fixes both.
  */
  .article-comments__pagination :is(.page, .deco, .next, .prev) {
    min-width: 24px;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
  }
  .article-comments__pagination a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .article-comments__form-title {
    font-family: var(--font-header--family);
    font-size: 1.125rem;
    margin: 0 0 var(--space-4);
  }
  .article-comments__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
  }
  .article-comments__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .article-comments__field input,
  .article-comments__field textarea {
    border: 1px solid var(--color-foreground-muted);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    padding: var(--space-2);
    font-family: inherit;
  }
  .article-comments__submit {
    align-self: flex-start;
    border: 1px solid var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    min-height: 24px;
  }
  .article-comments__success {
    color: var(--color-foreground);
    font-weight: 700;
  }
  .article-comments__errors {
    color: var(--color-urgency);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": []
}
{% endschema %}
