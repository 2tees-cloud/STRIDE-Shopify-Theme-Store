{% comment %}
  Row of columns, each with an optional image, a heading, and text —
  the classic "3 reasons to shop with us" / feature-grid section.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="multicolumn full-width">
    {% if section.settings.heading != blank %}
      <h2 class="multicolumn__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="multicolumn__grid">
      {% for block in section.blocks %}
        <div class="multicolumn__item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              class="multicolumn__image"
              src="{{ block.settings.image | image_url: width: 400 }}"
              srcset="{{ block.settings.image | image_url: width: 200 }} 200w, {{ block.settings.image | image_url: width: 400 }} 400w"
              sizes="(min-width: 750px) 25vw, 80vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
            >
          {% endif %}
          {% if block.settings.heading != blank %}
            <h3 class="multicolumn__item-heading">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="multicolumn__item-text">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .multicolumn {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    content-visibility: auto;
    contain-intrinsic-size: auto 500px;
  }
  @media (min-width: 750px) {
    .multicolumn {
      padding-inline: var(--space-6);
    }
  }
  .multicolumn__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .multicolumn__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 64rem;
    margin-inline: auto;
  }
  @media (min-width: 750px) {
    .multicolumn__grid {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }
  .multicolumn__item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .multicolumn__image {
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: var(--space-2);
  }
  .multicolumn__item-heading {
    font-family: var(--font-header--family);
    font-size: 1.125rem;
    margin: 0;
  }
  .multicolumn__item-text {
    color: var(--color-foreground-muted);
    line-height: 1.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.multicolumn",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:general.multicolumn_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.multicolumn",
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
