{% comment %}
  Full-bleed hero with an interactive colorway switcher: clicking a swatch
  instantly swaps the hero image (all colorway images are already in the
  DOM, so switching is instant with no network wait) and, if that
  colorway has a linked product, updates the CTA to point at it.

  A colorway can use a video instead of (or in addition to) its image --
  when both are set, the video plays and the image is only used as its
  poster frame while the video buffers. Every colorway's video is
  rendered up front (same "already in the DOM" instant-switch approach
  as the images), but only the active one is ever actually playing:
  assets in this file's javascript block play() the newly active video
  and pause() the previous one on swatch click, rather than
  autoplaying every video at once.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="hero full-width">
    <div class="hero__media">
      {% for block in section.blocks %}
        {% if block.settings.video %}
          <video
            class="hero__image{% if forloop.first %} is-active{% endif %}"
            poster="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1600 }}{% else %}{{ block.settings.video.preview_image | image_url: width: 1600 }}{% endif %}"
            muted
            loop
            playsinline
            preload="{% if forloop.first %}auto{% else %}metadata{% endif %}"
            {% unless forloop.first %}aria-hidden="true"{% endunless %}
            data-hero-image
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {% for source in block.settings.video.sources %}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {% endfor %}
          </video>
        {% elsif block.settings.image %}
          {% if forloop.first %}
            <img
              class="hero__image is-active"
              src="{{ block.settings.image | image_url: width: 1600 }}"
              srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
              sizes="100vw"
              alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="eager"
              fetchpriority="high"
              data-hero-image
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
          {% else %}
            <img
              class="hero__image"
              src="{{ block.settings.image | image_url: width: 1600 }}"
              srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1600 }} 1600w"
              sizes="100vw"
              alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              fetchpriority="low"
              aria-hidden="true"
              data-hero-image
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.blocks.size > 1 %}
        <div class="hero__swatches" role="group" aria-label="{{ 'hero.colorways' | t }}">
          {% for block in section.blocks %}
            <button
              type="button"
              class="hero__swatch{% if forloop.first %} is-active{% endif %}"
              style="--swatch-color: {{ block.settings.color }}"
              data-hero-swatch
              data-block-id="{{ block.id }}"
              data-product-url="{% if block.settings.product %}{{ block.settings.product.url | escape }}{% endif %}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'hero.view_in' | t: color: block.settings.color_name }}"
              {{ block.shopify_attributes }}
            ></button>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.cta_text != blank %}
        <a
          href="{% if section.blocks.first.settings.product %}{{ section.blocks.first.settings.product.url | escape }}{% else %}{{ section.settings.cta_link | escape }}{% endif %}"
          class="hero__cta"
          data-hero-cta
          data-default-href="{{ section.settings.cta_link | escape }}"
        >
          {{ section.settings.cta_text }}
        </a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .hero {
    position: relative;
  }
  .hero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    min-height: 26rem;
    overflow: hidden;
    background-color: var(--color-background-alt);
  }
  @media (min-width: 750px) {
    .hero__media {
      aspect-ratio: 16 / 9;
      min-height: 0;
      /* Uncapped, aspect-ratio: 16/9 scales the hero's height with
         viewport WIDTH alone -- on a wide monitor (1920px+) that's well
         over 1000px tall. .hero__content anchors the heading/swatches/CTA
         to the bottom of this box (justify-content: flex-end), so on a
         browser window shorter than that height, they'd sit below the
         initial fold with nothing on screen to suggest scrolling would
         reveal them. Capping the rendered height keeps the hero from
         growing past a real viewport on any screen width. */
      max-height: 44rem;
    }
  }
  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .hero__image.is-active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      transition: none;
    }
  }
  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    color: var(--color-on-accent);
    background: linear-gradient(to top, rgb(0 0 0 / 62%) 0%, rgb(0 0 0 / 55%) 45%, transparent 80%);
  }
  @media (min-width: 750px) {
    .hero__content {
      padding: var(--space-6);
    }
  }
  .hero__heading {
    font-family: var(--font-header--family);
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0;
  }
  .hero__subheading {
    font-size: 1.125rem;
    margin: 0;
    max-width: 40ch;
  }
  .hero__swatches {
    display: flex;
    gap: var(--space-2);
  }
  .hero__swatch {
    width: 2rem;
    height: 2rem;
    min-width: 24px;
    min-height: 24px;
    border-radius: 50%;
    background-color: var(--swatch-color);
    border: 2px solid transparent;
    box-shadow: 0 0 0 1px var(--color-foreground-muted);
    cursor: pointer;
    padding: 0;
  }
  .hero__swatch.is-active {
    border-color: var(--color-on-accent);
  }
  .hero__swatch:focus-visible {
    outline: 2px solid var(--color-on-accent);
    outline-offset: 2px;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    text-decoration: none;
    font-weight: 700;
  }
{% endstylesheet %}

{% javascript %}
  function activateColorway(hero, blockId) {
    var targetSwatch = null;

    hero.querySelectorAll('[data-hero-swatch]').forEach(function (s) {
      var isActive = s.dataset.blockId === blockId;
      if (isActive) targetSwatch = s;
      s.classList.toggle('is-active', isActive);
      s.setAttribute('aria-pressed', isActive);
    });

    hero.querySelectorAll('[data-hero-image]').forEach(function (media) {
      var isActive = media.dataset.blockId === blockId;
      media.classList.toggle('is-active', isActive);
      media.toggleAttribute('aria-hidden', !isActive);

      if (media.tagName === 'VIDEO') {
        if (isActive) {
          // play() returns a promise that can reject if the browser's
          // autoplay policy blocks it -- shouldn't happen given
          // muted+playsinline, but a swatch click is itself a user
          // gesture anyway, so this is just a safety net against an
          // unhandled rejection showing up in the console.
          media.play().catch(function () {});
        } else {
          media.pause();
        }
      }
    });

    var cta = hero.querySelector('[data-hero-cta]');
    if (cta && targetSwatch) {
      cta.setAttribute('href', targetSwatch.dataset.productUrl || cta.dataset.defaultHref);
    }
  }

  function initHero(root) {
    root.querySelectorAll('[data-hero-swatch]').forEach(function (swatch) {
      swatch.addEventListener('click', function () {
        var hero = swatch.closest('.hero');
        if (!hero) return;
        activateColorway(hero, swatch.dataset.blockId);
      });
    });

    // The initially active colorway's video (if any) isn't reached by a
    // swatch click, so it never gets the play() call above -- start it
    // here instead, once on load.
    root.querySelectorAll('[data-hero-image].is-active').forEach(function (media) {
      if (media.tagName === 'VIDEO') {
        media.play().catch(function () {});
      }
    });
  }

  initHero(document);
  document.addEventListener('shopify:section:load', function (event) {
    initHero(event.target);
  });

  // Editor-only in practice (this event is never dispatched outside theme
  // preview/design mode): when a merchant selects a colorway BLOCK -- via
  // the sidebar block list or by clicking its swatch/image in the preview
  // -- force that colorway to become the visibly active one. Without this,
  // selecting a currently-inactive colorway opens its settings panel but
  // the preview keeps showing whichever colorway was active before,
  // making it look like the block's own fields (Image, Product, etc.)
  // aren't there or aren't taking effect. Mirrors the same
  // shopify:block:select handling Dawn's own slideshow section uses to
  // scroll a non-visible slide into view when its block is selected.
  document.addEventListener('shopify:block:select', function (event) {
    var hero = event.target.closest('.hero');
    if (!hero) return;
    activateColorway(hero, event.detail.blockId);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Feels like you"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subtext"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:labels.cta_text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "colorway",
      "name": "t:general.colorway",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:labels.hero_image_info"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:labels.video",
          "info": "t:labels.hero_video_info"
        },
        {
          "type": "color",
          "id": "color",
          "label": "t:labels.color",
          "default": "#B5502D"
        },
        {
          "type": "text",
          "id": "color_name",
          "label": "t:labels.color_name",
          "default": "Clay"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.hero",
      "blocks": [
        { "type": "colorway" },
        { "type": "colorway" }
      ]
    }
  ]
}
{% endschema %}
