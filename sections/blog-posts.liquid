{% comment %}
  Recent-articles teaser for use on the homepage or any other page —
  distinct from sections/blog.liquid (the actual /blogs/[handle] listing
  page, which also has real pagination). Same .article-card markup/
  class names as that section for a consistent look, but with its own
  copy of the CSS rather than relying on cross-file class reuse (see
  the stylesheet comment below).
{% endcomment %}

{% if section.settings.blog != blank %}
  {% assign featured_blog = section.settings.blog %}
  <div class="blog-posts full-width">
    {% if section.settings.heading != blank %}
      <h2 class="blog-posts__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="blog-posts__grid blog-posts__grid--{{ section.settings.layout }}">
      {% for article in featured_blog.articles limit: section.settings.item_limit %}
        <a href="{{ article.url }}" class="article-card blog-posts__item">
          <div class="article-card__media">
            {% if article.image %}
              {% render 'image', image: article.image, class: 'article-card__image', width: 800 %}
            {% else %}
              <div class="article-card__image article-card__image--placeholder"></div>
            {% endif %}
          </div>
          <div class="article-card__content">
            <h3 class="article-card__title">{{ article.title }}</h3>
            {% assign date = article.published_at | time_tag: format: 'date' %}
            <p class="article-card__meta">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
            {% if article.excerpt_or_content != blank %}
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html }}</p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .blog-posts {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }
  @media (min-width: 750px) {
    .blog-posts {
      padding-inline: var(--space-6);
    }
  }
  .blog-posts__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .blog-posts__grid--grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 750px) {
    .blog-posts__grid--grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .blog-posts__grid--carousel {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-2);
  }
  .blog-posts__grid--carousel .blog-posts__item {
    flex: 0 0 16rem;
    scroll-snap-align: start;
  }
  /*
    Duplicated from sections/blog.liquid's own .article-card rules
    rather than relying on it being already defined there: theme-check's
    ValidScopedCSSClass rule (correctly) flags cross-file class reuse as
    fragile even though Shopify happens to bundle every section's
    stylesheet tag theme-wide (see sections/page.liquid's comment on
    that bundling behavior) -- this file should be self-contained.
  */
  .article-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-foreground);
  }
  .article-card__media {
    position: relative;
  }
  .article-card__image--placeholder {
    aspect-ratio: 16 / 9;
    background-color: var(--color-background-alt);
  }
  .article-card__title {
    font-family: var(--font-header--family);
    font-size: 1.125rem;
    font-weight: 400;
    margin: 0;
  }
  .article-card__meta {
    color: var(--color-foreground-muted);
    font-size: 0.875rem;
    margin: 0;
  }
  .article-card__excerpt {
    color: var(--color-foreground);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog_posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "From the blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:labels.blog"
    },
    {
      "type": "range",
      "id": "item_limit",
      "label": "t:labels.item_limit",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout_direction",
      "options": [
        { "value": "grid", "label": "t:options.blog_posts_layout.grid" },
        { "value": "carousel", "label": "t:options.blog_posts_layout.carousel" }
      ],
      "default": "grid"
    }
  ],
  "presets": [{ "name": "t:general.blog_posts" }]
}
{% endschema %}
