{% comment %}
  A short row of manual image+title+link cards -- lighter-weight than
  Collection list: Grid (sections/collection-list-grid.liquid), which
  requires picking real collection resources. This one takes a plain
  image, title, and URL per block, so it works for linking to anything
  (a collection, a page, an external URL), not just collections.
  "Spotlight" renders large image cards; "Text" drops the images for a
  plain underlined link list.
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="collection-links full-width">
    {% if section.settings.heading != blank %}
      <h2 class="collection-links__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="collection-links__list collection-links__list--{{ section.settings.style }}">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | escape }}" class="collection-links__item" {{ block.shopify_attributes }}>
          {% if section.settings.style == 'spotlight' and block.settings.image != blank %}
            <img
              class="collection-links__image"
              src="{{ block.settings.image | image_url: width: 800 }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
            >
          {% endif %}
          <span class="collection-links__title">{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .collection-links {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
  }
  @media (min-width: 750px) {
    .collection-links {
      padding-inline: var(--space-6);
    }
  }
  .collection-links__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
    text-align: center;
  }
  .collection-links__list--spotlight {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 750px) {
    .collection-links__list--spotlight {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }
  .collection-links__list--spotlight .collection-links__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-foreground);
  }
  .collection-links__image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 80%;
    display: block;
  }
  .collection-links__list--spotlight .collection-links__title {
    font-family: var(--font-header--family);
    font-size: 1.125rem;
    text-align: center;
  }
  .collection-links__list--text {
    display: flex;
    flex-direction: column;
    max-width: 30rem;
    margin-inline: auto;
  }
  .collection-links__list--text .collection-links__item {
    display: flex;
    align-items: center;
    min-height: 24px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-foreground);
    font-family: var(--font-header--family);
    font-size: 1.125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_links",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:labels.style",
      "options": [
        { "value": "spotlight", "label": "t:options.collection_links_style.spotlight" },
        { "value": "text", "label": "t:options.collection_links_style.text" }
      ],
      "default": "spotlight"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "t:general.collection_links_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.collection_links",
      "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }]
    }
  ]
}
{% endschema %}
