{% comment %}
  Full-bleed static image with large overlaid text — the magazine-style
  "editorial" banner used mid-page, distinct from the interactive
  Hero (sections/hero-colorway.liquid) which is homepage-top-only and
  drives the colorway switcher/product link. This is single-image,
  no interactivity.
{% endcomment %}

{% if section.settings.image != blank or section.settings.heading != blank %}
  <div class="editorial full-width">
    {% if section.settings.image != blank %}
      <img
        class="editorial__image"
        src="{{ section.settings.image | image_url: width: 1600 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
      >
    {% endif %}

    <div class="editorial__content">
      {% if section.settings.heading != blank %}
        <h2 class="editorial__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="editorial__text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link | escape }}" class="editorial__cta">{{ section.settings.cta_text }}</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .editorial {
    position: relative;
  }
  .editorial__image {
    width: 100%;
    height: 32rem;
    object-fit: cover;
    display: block;
  }
  @media (min-width: 750px) {
    .editorial__image {
      height: 40rem;
    }
  }
  .editorial__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-3);
    padding: var(--space-4);
    color: var(--color-on-accent);
    background: rgb(0 0 0 / 30%);
  }
  .editorial__heading {
    font-family: var(--font-header--family);
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin: 0;
  }
  .editorial__text {
    max-width: 40ch;
    margin: 0;
  }
  .editorial__cta {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    text-decoration: none;
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.subtext"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:labels.cta_text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    }
  ],
  "presets": [{ "name": "t:general.editorial" }]
}
{% endschema %}
