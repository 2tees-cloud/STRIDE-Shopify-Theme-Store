{% comment %}
  Classic two-column image + text block, with the image side switchable
  left/right — the general-purpose "tell a story next to a photo"
  section every theme section library ships alongside Rich text.
{% endcomment %}

{% if section.settings.image != blank or section.settings.heading != blank or section.settings.text != blank %}
  <div class="image-with-text full-width{% if section.settings.image_position == 'right' %} image-with-text--image-right{% endif %}">
    <div class="image-with-text__media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 750px) 50vw, 100vw"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        >
      {% endif %}
    </div>

    <div class="image-with-text__content">
      {% if section.settings.heading != blank %}
        <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="image-with-text__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link | escape }}" class="image-with-text__cta">{{ section.settings.cta_text }}</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .image-with-text {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 750px) {
    .image-with-text {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-8);
    }
    .image-with-text--image-right {
      grid-template-columns: 1fr 1fr;
    }
    .image-with-text--image-right .image-with-text__media {
      order: 2;
    }
    .image-with-text--image-right .image-with-text__content {
      order: 1;
    }
  }
  .image-with-text__media img {
    width: 100%;
    height: auto;
    display: block;
  }
  .image-with-text__content {
    padding-inline: var(--space-4);
  }
  @media (min-width: 750px) {
    .image-with-text__content {
      padding-inline: 0;
    }
    .image-with-text--image-right .image-with-text__content {
      padding-left: 0;
      padding-right: var(--space-6);
    }
    .image-with-text:not(.image-with-text--image-right) .image-with-text__content {
      padding-right: var(--space-6);
      padding-left: 0;
    }
  }
  .image-with-text__heading {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-4);
  }
  .image-with-text__text {
    color: var(--color-foreground-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  .image-with-text__text p:last-child {
    margin-bottom: 0;
  }
  .image-with-text__cta {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-foreground);
    color: var(--color-background);
    text-decoration: none;
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "left", "label": "t:options.image_position.left" },
        { "value": "right", "label": "t:options.image_position.right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:labels.cta_text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    }
  ],
  "presets": [{ "name": "t:general.image_with_text" }]
}
{% endschema %}
