{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us. Adds rich-text (RTE) typography for page.content per spec
  section 5.11 — headings, paragraphs, lists, and blockquotes — mirroring the
  established content-styling approach already used by sections/article.liquid's
  .article__content (font-header--family on headings, list indent, paragraph
  spacing, responsive images), with the addition of blockquote styling, which
  spec section 5.11 explicitly requires and article.liquid's own pattern does
  not currently have. Same content-width constraint (48rem, centered) as
  article.liquid, since both are long-form-text pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page full-width">
  <h1 class="page__title">{{ page.title }}</h1>

  <div class="page__content">
    {{ page.content }}
  </div>
</div>

{% stylesheet %}
  .page {
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    max-width: 48rem;
    margin-inline: auto;
  }
  @media (min-width: 750px) {
    .page {
      padding-inline: var(--space-6);
    }
  }
  .page__title {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-6);
  }
  .page__content {
    color: var(--color-foreground);
    line-height: 1.6;
  }
  .page__content > :first-child {
    margin-top: 0;
  }
  .page__content > :last-child {
    margin-bottom: 0;
  }
  .page__content :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--font-header--family);
    line-height: 1.25;
    margin: var(--space-6) 0 var(--space-2);
  }
  .page__content h1 {
    font-size: 2rem;
  }
  .page__content h2 {
    font-size: 1.75rem;
  }
  .page__content h3 {
    font-size: 1.5rem;
  }
  .page__content h4 {
    font-size: 1.25rem;
  }
  .page__content h5 {
    font-size: 1.125rem;
  }
  .page__content h6 {
    font-size: 1rem;
  }
  .page__content p {
    margin: 0 0 var(--space-4);
  }
  .page__content :is(ul, ol) {
    padding-inline-start: var(--space-5);
    margin: 0 0 var(--space-4);
  }
  .page__content li {
    margin-bottom: var(--space-1);
  }
  .page__content blockquote {
    margin: var(--space-4) 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-border);
    color: var(--color-foreground-muted);
    font-style: italic;
  }
  .page__content blockquote p:last-child {
    margin-bottom: 0;
  }
  .page__content a {
    color: var(--color-foreground);
  }
  .page__content img {
    max-width: 100%;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
