{% comment %}
  Spotlights one chosen product with its own image/title/price, linking
  through to the real product page rather than embedding a second
  add-to-cart form on the page -- sections/product.liquid's buy-box
  blocks (variant picker, quantity, buy buttons) are built around that
  one page's single {% form 'product' %} and its own JS hooks
  (assets/product-variant-picker.js), so duplicating them into an
  unrelated section here would risk two forms fighting over the same
  ids/selectors. A clear "Shop now" link keeps this section simple and
  safe to place on any page.
{% endcomment %}

{% if section.settings.product != blank %}
  {% assign featured_product = section.settings.product %}
  <div class="featured-product full-width">
    <div class="featured-product__media">
      {% if featured_product.featured_image %}
        <img
          src="{{ featured_product.featured_image | image_url: width: 1200 }}"
          srcset="{{ featured_product.featured_image | image_url: width: 600 }} 600w, {{ featured_product.featured_image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 750px) 50vw, 100vw"
          width="{{ featured_product.featured_image.width }}"
          height="{{ featured_product.featured_image.height }}"
          loading="lazy"
          alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}"
        >
      {% endif %}
    </div>

    <div class="featured-product__content">
      {% if section.settings.heading != blank %}
        <p class="featured-product__eyebrow">{{ section.settings.heading }}</p>
      {% endif %}
      <h2 class="featured-product__title">{{ featured_product.title }}</h2>
      <div class="featured-product__price">
        {% if featured_product.price_varies %}
          {{ 'product.price_from_html' | t: price: featured_product.price_min | money }}
        {% else %}
          {{ featured_product.price | money }}
        {% endif %}
      </div>
      {% if featured_product.description != blank %}
        <div class="featured-product__description">{{ featured_product.description | strip_html | truncatewords: 30 }}</div>
      {% endif %}
      <a href="{{ featured_product.url }}" class="featured-product__cta">{{ 'general.shop_now' | t }}</a>
      {% content_for 'blocks' %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .featured-product {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
  }
  @media (min-width: 750px) {
    .featured-product {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-8);
      padding-inline: var(--space-6);
    }
  }
  .featured-product__media img {
    width: 100%;
    height: auto;
    display: block;
  }
  .featured-product__eyebrow {
    color: var(--color-foreground-muted);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-2);
  }
  .featured-product__title {
    font-family: var(--font-header--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 var(--space-2);
  }
  .featured-product__price {
    font-size: 1.125rem;
    margin-bottom: var(--space-4);
  }
  .featured-product__description {
    color: var(--color-foreground-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  .featured-product__cta {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-foreground);
    color: var(--color-background);
    text-decoration: none;
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.eyebrow_text"
    }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "t:general.featured_product" }]
}
{% endschema %}
