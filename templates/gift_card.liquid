{% layout none %}
{% comment %}
  Standalone gift-card page. Uses layout none and renders its own full
  html document (no theme header/footer), matching Shopify's convention
  for this template. Restyled to spec section 5.7 using the theme's own
  design tokens (css-variables.liquid) instead of raw browser defaults,
  and adds the required QR code (at least 120 by 120 pixels).

  QR code approach: Shopify serves a global, content-hashed vendor
  script through the shopify_asset_url filter at
  vendor/qrcode.js - confirmed live in this project's own theme dev
  environment (a direct fetch of the resolved CDN path returned a real
  200 response containing a QRCode constructor), not just assumed from
  documentation. That constructor is initialized client-side against a
  container element's data-identifier attribute, the same pattern
  Shopify's own Dawn reference theme uses in its current, live source.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/gift-card
{% endcomment %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # QR code vendor library, loaded from Shopify's global asset CDN %}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>

    {% style %}
      body {
        margin: 0;
        background-color: var(--color-background);
        color: var(--color-foreground);
        font-family: var(--font-body--family);
      }
      .gift-card-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding-block: var(--space-8);
        padding-inline: var(--space-4);
        box-sizing: border-box;
        text-align: center;
      }
      @media (min-width: 750px) {
        .gift-card-page {
          padding-inline: var(--space-6);
        }
      }
      .gift-card {
        max-width: 28rem;
        width: 100%;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-5);
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--style-border-radius-inputs);
        padding: var(--space-6) var(--space-5);
        box-sizing: border-box;
      }
      .gift-card__balance {
        font-family: var(--font-header--family);
        font-size: clamp(2rem, 6vw, 2.75rem);
        margin: 0;
      }
      .gift-card__badge {
        display: inline-block;
        color: var(--color-urgency);
        font-weight: 700;
        margin: 0;
      }
      .gift-card__expiry {
        color: var(--color-foreground-muted);
        margin: 0;
      }
      .gift-card__image-wrapper {
        width: 100%;
      }
      .gift-card__image {
        display: block;
        max-width: 100%;
        height: auto;
        margin-inline: auto;
        border-radius: var(--style-border-radius-inputs);
      }
      .gift-card__shop-name {
        font-family: var(--font-header--family);
        font-size: clamp(1.25rem, 4vw, 1.5rem);
        margin: 0;
      }
      .gift-card__instructions {
        color: var(--color-foreground-muted);
        margin: 0;
      }
      .gift-card__code {
        font-family: monospace;
        font-size: clamp(1.125rem, 3vw, 1.375rem);
        letter-spacing: 0.05em;
        background-color: var(--color-background-alt);
        border: 1px solid var(--color-border);
        border-radius: var(--style-border-radius-inputs);
        padding: var(--space-3) var(--space-5);
        margin: 0;
      }
      .gift-card__qr {
        width: 160px;
        height: 160px;
        min-width: 120px;
        min-height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-background);
        border: 1px solid var(--color-border);
        border-radius: var(--style-border-radius-inputs);
        padding: var(--space-2);
        box-sizing: content-box;
      }
      .gift-card__qr canvas {
        max-width: 100%;
        height: auto;
      }
      .gift-card__wallet {
        display: inline-flex;
        min-height: 24px;
      }
      .gift-card__wallet img {
        max-width: 100%;
        height: auto;
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main>
      <div class="shopify-section">
        <div class="gift-card-page full-width">
          <div class="gift-card">
            <h1 class="gift-card__balance">{{ gift_card.balance | money }}</h1>

            {% if gift_card.enabled == false or gift_card.expired %}
              <p class="gift-card__badge">{{ 'gift_card.expired' | t }}</p>
            {% endif %}

            {% if gift_card.expires_on %}
              {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
              <p class="gift-card__expiry">
                {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
              </p>
            {% endif %}

            <div class="gift-card__image-wrapper">
              {% if settings.logo %}
                {{
                  settings.logo
                  | image_url: width: 300
                  | image_tag: alt: shop.name, class: 'gift-card__image'
                }}
              {% else %}
                <img
                  class="gift-card__image"
                  src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
                  alt="{{ 'gift_card.card' | t }}"
                  width="300"
                  height="200"
                >
              {% endif %}
            </div>

            <h2 class="gift-card__shop-name">{{ shop.name }}</h2>
            <p class="gift-card__instructions">{{ 'gift_card.use_at_checkout' | t }}</p>
            <p class="gift-card__code">{{ gift_card.code | format_code }}</p>

            <div
              class="gift-card__qr-code gift-card__qr"
              data-identifier="{{ gift_card.qr_identifier }}"
              role="img"
              aria-label="{{ 'gift_card.qr_code_alt' | t }}"
            ></div>

            {% if gift_card.pass_url %}
              <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
                <img
                  src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                  alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                  width="200"
                  height="60"
                >
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qrContainer = document.querySelector('.gift-card__qr-code');
        if (qrContainer && qrContainer.dataset.identifier && window.QRCode) {
          new QRCode(qrContainer, {
            text: qrContainer.dataset.identifier,
            width: 160,
            height: 160,
            imageAltText: {{ 'gift_card.qr_code_alt' | t | json }}
          });
        }
      });
    </script>
  </body>
</html>
