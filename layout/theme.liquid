<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {{ content_for_header }}
  </head>

  <body>
    <div class="scroll-sentinel" data-scroll-sentinel></div>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

    {% comment %}
      product-variant-picker.js only has work to do on the product
      template, so it's gated here rather than loading globally. It's
      loaded from the layout (not from sections/product.liquid) so it
      always executes exactly once per full page load, the same
      guarantee cart-drawer.js relies on above — sections/product.liquid
      is inside the theme editor's Section Rendering API hot-reload
      path (shopify:section:load), and an embedded <script src> there
      would be a candidate for re-executing on every editor reload,
      double-registering this script's module-scope
      shopify:section:load listener. Loading from the layout sidesteps
      that entirely.
    {% endcomment %}
    {% if template == 'product' %}
      <script src="{{ 'product-variant-picker.js' | asset_url }}" defer></script>
    {% endif %}
  </body>
</html>
